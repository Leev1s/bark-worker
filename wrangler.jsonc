{
    "name": "bark-worker",
    "main": "main_kv.js",
    "compatibility_date": "2026-03-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true
    },
    "kv_namespaces": [
        {
            "binding": "database",
            // Muse: replace this placeholder with the Cloudflare KV namespace ID.
            "id": "REPLACE_WITH_KV_NAMESPACE_ID"
        }
    ],
    "keep_vars": true,
    "vars": {
        "ALLOW_NEW_DEVICE": "true",
        "ALLOW_QUERY_NUMS": "true",
        "ROOT_PATH": "/",
        // "BASIC_AUTH": ""
    }
}